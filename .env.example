# Firebase web app config — copy this file to `.env` and fill in the values.
#
# Get them from the Firebase console of the SAME project the web app uses:
#   Project settings → General → Your apps → the Web app → "SDK setup and configuration"
#
# These are `EXPO_PUBLIC_` vars, so they are inlined into the app bundle and are
# readable by anyone with the app. That is expected for Firebase web config —
# these identify the project, they do not grant access. Access is enforced by
# Firestore security rules. Never put a service-account key or admin credential here.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
